# ===========================================
# Primus IDP Production Environment Variables
# ===========================================
# Copy this file to .env.production and fill in your values

# Domain Configuration
DOMAIN=primusidp.net
ACME_EMAIL=admin@primusidp.net

# Database
POSTGRES_USER=primus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=primus_idp

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Application Security
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# LLM Configuration (Choose one or more)
# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Google AI
GOOGLE_API_KEY=

# Ollama (Self-hosted)
OLLAMA_BASE_URL=http://ollama:11434

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# Connector OAuth (Optional)
# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Traefik Dashboard Auth (generate with: htpasswd -nb admin yourpassword)
TRAEFIK_USERS=admin:$$apr1$$xyz$$hash
